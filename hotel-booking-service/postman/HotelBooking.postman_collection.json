    {
      "name": "02. Обязательные методы",
      "description": "15 запросов из таблицы задания. Выполнять сверху вниз.",
      "item": [
        {
          "name": "1. GET отели по городу",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=Москва",
              "protocol": "http",
              "host": [
                "{{host}}"
              ],
              "port": "{{port}}",
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "Москва"
                }
              ]
            },
            "description": "Ожидается 200 OK."
          }
        },
        {
          "name": "2. GET отель по id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels/1",
