              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Hotel\",\n  \"city\": \"Москва\",\n  \"address\": \"ул. Демонстрационная, 1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
