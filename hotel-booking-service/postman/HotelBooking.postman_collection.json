{
  "info": {
    "name": "Hotel Booking — 23 запроса",
    "description": "Минимальная коллекция для защиты: 4 подготовительных запроса, 15 обязательных методов из задания и 4 ошибочных сценария. Перед запуском выбери окружение Hotel Booking Local. Папки выполнять сверху вниз.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Подготовка",
      "description": "Два GET-запроса нужны, чтобы узнать существующие id. POST-запросы необязательны.",
      "item": [
        {
          "name": "GET типы номеров",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/room-types",
              "protocol": "http",
              "host": [
                "{{host}}"
              ],
              "port": "{{port}}",
              "path": [
                "api",
                "room-types"
              ]
            },
            "description": "Ожидается 200 OK. Первый id сохраняется в roomTypeId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set('roomTypeId', data[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET клиенты",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/clients",
              "protocol": "http",
              "host": [
                "{{host}}"
              ],
              "port": "{{port}}",
              "path": [
                "api",
                "clients"
              ]
            },
            "description": "Ожидается 200 OK. Первый id сохраняется в clientId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set('clientId', data[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST создать тип номера (необязательно)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/room-types",
              "protocol": "http",
              "host": [
                "{{host}}"
              ],
              "port": "{{port}}",
              "path": [
                "api",
                "room-types"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Апартаменты\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Ожидается 201 Created. Повторный запуск даст 409 — это нормально."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
