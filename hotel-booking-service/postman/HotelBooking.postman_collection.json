            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Hotel & Spa\",\n  \"city\": \"Москва\",\n  \"address\": \"ул. Демонстрационная, 1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
